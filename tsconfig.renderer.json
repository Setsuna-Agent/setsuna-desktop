{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["apps/desktop/renderer/src/*"],
      "@setsuna-desktop/contracts": ["packages/contracts/src/index.ts"],
      "@setsuna-desktop/feature-core/*": ["packages/feature-core/src/*"],
      "@setsuna-desktop/feature-browser/*": ["packages/features/browser/src/*"],
      "@setsuna-desktop/feature-collaboration/*": ["packages/features/collaboration/src/*"],
      "@setsuna-desktop/feature-conversation-debug/*": ["packages/features/conversation-debug/src/*"],
      "@setsuna-desktop/feature-image-generation/*": ["packages/features/image-generation/src/*"],
      "@setsuna-desktop/feature-goal/*": ["packages/features/goal/src/*"],
      "@setsuna-desktop/feature-memory/*": ["packages/features/memory/src/*"],
      "@setsuna-desktop/feature-network-proxy/*": ["packages/features/network-proxy/src/*"],
      "@setsuna-desktop/feature-plugin-management/*": ["packages/features/plugin-management/src/*"],
      "@setsuna-desktop/feature-review/*": ["packages/features/review/src/*"],
      "@setsuna-desktop/feature-runtime-activity/*": ["packages/features/runtime-activity/src/*"],
      "@setsuna-desktop/feature-terminal/*": ["packages/features/terminal/src/*"],
      "@setsuna-desktop/feature-usage/*": ["packages/features/usage/src/*"],
      "@setsuna-desktop/feature-updater/*": ["packages/features/updater/src/*"],
      "@setsuna-desktop/feature-vision-recognition/*": ["packages/features/vision-recognition/src/*"],
      "@setsuna-desktop/feature-webdav-sync/*": ["packages/features/webdav-sync/src/*"],
      "@setsuna-desktop/feature-windows-sandbox/*": ["packages/features/windows-sandbox/src/*"],
      "@setsuna-desktop/feature-workspace-apps/*": ["packages/features/workspace-apps/src/*"],
      "@setsuna-desktop/feature-workspace-dependencies/*": ["packages/features/workspace-dependencies/src/*"]
    }
  },
  "include": [
    "apps/desktop/renderer/src/**/*.ts",
    "apps/desktop/renderer/src/**/*.tsx",
    "apps/desktop/renderer/test/**/*.ts",
    "apps/desktop/renderer/test/**/*.tsx"
  ],
  "references": [
    { "path": "./packages/contracts/tsconfig.build.json" },
    { "path": "./packages/feature-core/tsconfig.build.json" },
    { "path": "./packages/features/browser/tsconfig.build.json" },
    { "path": "./packages/features/collaboration/tsconfig.build.json" },
    { "path": "./packages/features/conversation-debug/tsconfig.build.json" },
    { "path": "./packages/features/image-generation/tsconfig.build.json" },
    { "path": "./packages/features/goal/tsconfig.build.json" },
    { "path": "./packages/features/memory/tsconfig.build.json" },
    { "path": "./packages/features/network-proxy/tsconfig.build.json" },
    { "path": "./packages/features/plugin-management/tsconfig.build.json" },
    { "path": "./packages/features/review/tsconfig.build.json" },
    { "path": "./packages/features/runtime-activity/tsconfig.build.json" },
    { "path": "./packages/features/terminal/tsconfig.build.json" },
    { "path": "./packages/features/usage/tsconfig.build.json" },
    { "path": "./packages/features/updater/tsconfig.build.json" },
    { "path": "./packages/features/vision-recognition/tsconfig.build.json" },
    { "path": "./packages/features/webdav-sync/tsconfig.build.json" },
    { "path": "./packages/features/windows-sandbox/tsconfig.build.json" },
    { "path": "./packages/features/workspace-apps/tsconfig.build.json" },
    { "path": "./packages/features/workspace-dependencies/tsconfig.build.json" }
  ]
}
