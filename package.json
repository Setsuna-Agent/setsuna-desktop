{
  "name": "setsuna-desktop",
  "version": "0.2.4",
  "packageManager": "pnpm@7.33.7",
  "description": "Local-first desktop runtime and workbench for Setsuna Agent workflows.",
  "author": {
    "name": "Setsuna Agent",
    "email": "1182900548@qq.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main/index.js",
  "private": false,
  "scripts": {
    "benchmark:feature-projection": "tsx scripts/benchmark-feature-projection.ts",
    "dev": "concurrently -k -s command-electron -n renderer,electron \"pnpm dev:renderer\" \"wait-on tcp:5174 && pnpm dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174",
    "dev:electron": "pnpm prepare:electron && tsx scripts/start-electron-dev.ts",
    "build": "pnpm clean && pnpm build:contracts && pnpm build:feature-core && pnpm build:features && pnpm build:runtime && pnpm build:electron && pnpm build:renderer",
    "build:contracts": "tsc -b packages/contracts/tsconfig.build.json",
    "build:feature-core": "tsc -b packages/feature-core/tsconfig.build.json",
    "build:features": "pnpm --recursive --filter \"./packages/features/*\" run build",
    "build:runtime": "tsc -b packages/desktop-runtime/tsconfig.build.json",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:renderer": "vite build",
    "build:windows-sandbox": "node scripts/windows-sandbox/prepare-windows-sandbox.mjs --platform win32 --arch x64",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/generate-tree.mjs --check",
    "clean": "node scripts/clean.mjs",
    "docs:tree": "node scripts/generate-tree.mjs",
    "lint": "eslint . --max-warnings=0",
    "package": "node scripts/validate-release-version.mjs && pnpm build && electron-builder --dir",
    "package:linux:x64": "node scripts/validate-release-version.mjs && pnpm build && electron-builder --linux --x64 --publish never",
    "package:mac:arm64": "node scripts/validate-release-version.mjs && pnpm build && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "node scripts/validate-release-version.mjs && pnpm build && electron-builder --mac --x64 --publish never",
    "package:win:x64": "node scripts/validate-release-version.mjs && pnpm build && electron-builder --win --x64 --publish never --config.npmRebuild=false",
    "prepare:electron": "node scripts/prepare-electron.mjs",
    "prepare:windows-sandbox-curl": "node scripts/windows-sandbox/prepare-sandbox-curl.mjs --platform win32 --arch x64",
    "postinstall": "node scripts/prepare-electron.mjs && node scripts/prepare-node-pty.mjs",
    "release:dry-run": "node scripts/validate-release-version.mjs && pnpm build && node scripts/release-dry-run.mjs",
    "start": "pnpm prepare:electron && electron .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:all": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:release": "node scripts/ripgrep/prepare-ripgrep.mjs && vitest run --config vitest.release.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:windows-sandbox": "cargo test --locked --manifest-path native/windows-sandbox/Cargo.toml --all-targets",
    "typecheck": "pnpm check:architecture && tsc -b --pretty false",
    "validate:release-version": "node scripts/validate-release-version.mjs"
  },
  "dependencies": {
    "@ant-design/x": "^2.5.0",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@pierre/diffs": "1.3.3",
    "@setsuna-desktop/contracts": "workspace:*",
    "@setsuna-desktop/feature-core": "workspace:*",
    "@setsuna-desktop/feature-browser": "workspace:*",
    "@setsuna-desktop/feature-collaboration": "workspace:*",
    "@setsuna-desktop/feature-image-generation": "workspace:*",
    "@setsuna-desktop/feature-goal": "workspace:*",
    "@setsuna-desktop/feature-memory": "workspace:*",
    "@setsuna-desktop/feature-review": "workspace:*",
    "@setsuna-desktop/feature-terminal": "workspace:*",
    "@setsuna-desktop/feature-updater": "workspace:*",
    "@setsuna-desktop/feature-vision-recognition": "workspace:*",
    "@setsuna-desktop/feature-webdav-sync": "workspace:*",
    "@setsuna-desktop/feature-workspace-dependencies": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.3.6",
    "corepack": "0.34.7",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.1",
    "node-pty": "^1.1.0",
    "proxy-chain": "3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.0",
    "seti-file-icons": "^0.0.8",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "happy-dom": "^20.11.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=7"
  },
  "pnpm": {
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    }
  },
  "build": {
    "appId": "dev.setsuna.desktop",
    "productName": "Setsuna Desktop",
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release-artifacts",
      "buildResources": "assets/build"
    },
    "files": [
      "dist/**/*",
      "assets/build/icon.png",
      "assets/build/icon-windows.png",
      "package.json",
      "packages/contracts/package.json",
      "packages/feature-core/package.json",
      "packages/feature-core/dist/**/*",
      "packages/features/*/package.json",
      "packages/features/*/dist/**/*",
      "packages/desktop-runtime/package.json",
      "skills/**/*",
      "plugins/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/prebuilds/**/*"
    ],
    "extraResources": [
      {
        "from": ".cache/ripgrep/${os}-${arch}",
        "to": "setsuna-path",
        "filter": [
          "rg",
          "rg.exe",
          "LICENSE-MIT",
          "UNLICENSE",
          "COPYING",
          "NOTICE.txt",
          "metadata.json"
        ]
      }
    ],
    "mac": {
      "icon": "assets/build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Setsuna-Desktop-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "icon": "assets/build/icon.ico",
      "extraResources": [
        {
          "from": ".cache/sandbox-curl/win-x64",
          "to": "setsuna-path",
          "filter": [
            "curl.exe",
            "curl-ca-bundle.crt",
            "_curlrc",
            "LICENSE-CURL.txt",
            "THIRD-PARTY-LICENSES-CURL.txt",
            "NOTICE-CURL.txt",
            "curl-metadata.json"
          ]
        },
        {
          "from": ".cache/windows-sandbox/win-x64",
          "to": "setsuna-sandbox",
          "filter": [
            "setsuna-sandbox-win.exe",
            "LICENSE-APACHE.txt",
            "NOTICE.txt",
            "metadata.json"
          ]
        }
      ],
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Setsuna-Desktop-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "artifactName": "Setsuna-Desktop-${version}-ubuntu-${arch}.${ext}"
    }
  }
}
