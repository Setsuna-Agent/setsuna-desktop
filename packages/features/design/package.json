{
  "name": "@setsuna-desktop/feature-design",
  "version": "0.1.0",
  "description": "Editable design documents and canvas for Setsuna Desktop.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "dependencies": {
    "@setsuna-desktop/contracts": "workspace:*",
    "@setsuna-desktop/feature-core": "workspace:*",
    "@setsuna-desktop/renderer-ui": "workspace:*",
    "fontkit": "2.0.4",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "paper": "0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "18.2.14",
    "yoga-layout": "3.2.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
  },
  "devDependencies": {
    "@types/fontkit": "2"
  }
}
