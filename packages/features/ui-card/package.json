{
  "name": "@setsuna-desktop/feature-ui-card",
  "version": "0.1.0",
  "description": "Sandboxed Plugin UI cards and shared free-form UI frame for Setsuna Desktop.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "dependencies": {
    "@setsuna-desktop/contracts": "workspace:*",
    "@setsuna-desktop/feature-core": "workspace:*",
    "@setsuna-desktop/renderer-contracts": "workspace:*",
    "react": "^18.3.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
  }
}
