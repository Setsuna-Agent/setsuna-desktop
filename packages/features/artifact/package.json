    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "dependencies": {
    "@setsuna-desktop/contracts": "workspace:*",
    "@setsuna-desktop/feature-core": "workspace:*",
    "@setsuna-desktop/renderer-contracts": "workspace:*",
    "antd": "^6.3.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "seti-file-icons": "^0.0.8"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
