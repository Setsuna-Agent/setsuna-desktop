{
  "name": "@setsuna-desktop/feature-network-proxy",
  "version": "0.1.0",
  "description": "Desktop network proxy Feature for Setsuna Desktop.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "default": "./dist/preload/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "dependencies": {
    "@setsuna-desktop/contracts": "workspace:*",
    "@setsuna-desktop/feature-browser": "workspace:*",
    "@setsuna-desktop/feature-core": "workspace:*",
    "antd": "^6.3.6",
    "lucide-react": "^0.468.0",
    "proxy-chain": "3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "7.29.0"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b --pretty false"
  }
}
