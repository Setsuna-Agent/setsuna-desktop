    { "path": "../features/collaboration/tsconfig.build.json" },
    { "path": "../features/conversation-debug/tsconfig.build.json" },
    { "path": "../features/image-generation/tsconfig.build.json" },
    { "path": "../features/goal/tsconfig.build.json" },
    { "path": "../features/mcp/tsconfig.build.json" },
    { "path": "../features/memory/tsconfig.build.json" },
    { "path": "../features/model-provider/tsconfig.build.json" },
    { "path": "../features/plugin-management/tsconfig.build.json" },
    { "path": "../features/review/tsconfig.build.json" },
    { "path": "../features/runtime-activity/tsconfig.build.json" },
    { "path": "../features/usage/tsconfig.build.json" },
    { "path": "../features/vision-recognition/tsconfig.build.json" },
    { "path": "../features/windows-sandbox/tsconfig.build.json" },
